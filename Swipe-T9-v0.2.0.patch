@@ -0,0 +1,99 @@
+package io.github.sspanak.tt9.ui.main.swipe;
+
+/**
+ * Small, allocation-light gesture decoder. Receives positions in screen pixels.
+ * A complete loop within one key counts as ONE deliberate repeated key.
+ * No dictionary logic lives here: the resulting digits use the normal T9 engine.
+ */
+public final class SwipeT9Gesture {
+    private final StringBuilder sequence = new StringBuilder();
+    private final float[] sampleX = new float[200];
+    private final float[] sampleY = new float[200];
+    private int sampleCount;
+    private int digit = -1;
+    private boolean loopRecognized;
+    private float traveled;
+    private float keySize;
+    private float lowX, highX, lowY, highY;
+    private int horizontalDirection, horizontalTurns;
+    private float horizontalLeg, zigzagTravel;
+
+    public void reset() {
+        sequence.setLength(0);
+        digit = -1;
+        sampleCount = 0;
+        loopRecognized = false;
+        traveled = 0;
+        horizontalDirection = horizontalTurns = 0;
+        horizontalLeg = zigzagTravel = 0;
+    }
+
+    public String getDigits() { return sequence.toString(); }
+
+    public void add(int nextDigit, float x, float y, float keyWidth, float keyHeight) {
+        if (nextDigit < 2 || nextDigit > 9 || sequence.length() >= 32) return;
+        if (digit != nextDigit) {
+            digit = nextDigit;
+            sequence.append((char) ('0' + digit));
+            sampleCount = 0;
+            traveled = 0;
+            loopRecognized = false;
+            horizontalDirection = horizontalTurns = 0;
+            horizontalLeg = zigzagTravel = 0;
+            keySize = Math.max(1f, Math.min(keyWidth, keyHeight));
+            lowX = highX = x;
+            lowY = highY = y;
+        }
+        if (sampleCount > 0) {
+            float dx = x - sampleX[sampleCount - 1];
+            float dy = y - sampleY[sampleCount - 1];
+            traveled += (float) Math.hypot(dx, dy);
+            if (!loopRecognized && Math.abs(dx) > .03f * keySize) {
+                int direction = dx > 0 ? 1 : -1;
+                if (horizontalDirection != 0 && direction != horizontalDirection) {
+                    if (horizontalLeg >= .25f * keySize) {
+                        horizontalTurns++;
+                        zigzagTravel += horizontalLeg;
+                        horizontalDirection = direction;
+                        horizontalLeg = Math.abs(dx);
+                    }
+                } else {
+                    horizontalDirection = direction;
+                    horizontalLeg += Math.abs(dx);
+                }
+            }
+        }
+        lowX = Math.min(lowX, x); highX = Math.max(highX, x);
+        lowY = Math.min(lowY, y); highY = Math.max(highY, y);
+        if (sampleCount < sampleX.length) {
+            sampleX[sampleCount] = x;
+            sampleY[sampleCount] = y;
+            sampleCount++;
+        }
+        // Deliberate left-right-left is a second way to repeat a key. Tiny finger jitter
+        // does not pass the minimum travel/turn thresholds.
+        if (!loopRecognized && horizontalTurns >= 2 && zigzagTravel + horizontalLeg >= 1.1f * keySize
+                && highY - lowY < .25f * keySize && highX - lowX >= .32f * keySize) {
+            sequence.append((char) ('0' + digit));
+            loopRecognized = true;
+        }
+        if (!loopRecognized && sampleCount >= 7 && traveled >= 1.10f * keySize
+            && highX - lowX >= .25f * keySize && highY - lowY >= .25f * keySize) {
+            // Look for a real return to an earlier point, with enough perimeter between them.
+            for (int i = 0; i < sampleCount - 5; i++) {
+                float dx = x - sampleX[i], dy = y - sampleY[i];
+                if (Math.hypot(dx, dy) <= .20f * keySize) {
+                    float path = 0;
+                    for (int j = i + 1; j < sampleCount; j++) {
+                        path += Math.hypot(sampleX[j] - sampleX[j-1], sampleY[j] - sampleY[j-1]);
+                    }
+                    if (path >= .85f * keySize) {
+                        sequence.append((char) ('0' + digit));
+                        loopRecognized = true;
+                        break;
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/io/github/sspanak/tt9/ui/main/swipe/SwipeT9TouchLayout.java b/app/src/main/java/io/github/sspanak/tt9/ui/main/swipe/SwipeT9TouchLayout.java
new file mode 100644
index 0000000..f0df4d9
--- /dev/null
+++ b/app/src/main/java/io/github/sspanak/tt9/ui/main/swipe/SwipeT9TouchLayout.java
@@ -0,0 +1,129 @@
+package io.github.sspanak.tt9.ui.main.swipe;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.widget.LinearLayout;
+
+import io.github.sspanak.tt9.R;
+import io.github.sspanak.tt9.ime.TraditionalT9;
+
+/**
+ * Experimental opt-in swipe mode for the large touchscreen numpad.
+ * Taps and ordinary long presses continue to go to the original soft keys.
+ * Only a deliberate drag takes over the touch stream, cancelling the original key.
+ */
+public final class SwipeT9TouchLayout extends LinearLayout {
+    private static final String PREFS = "swipe_t9_experiment";
+    private static final String ENABLED = "swipe_enabled";
+    private final int[] digitIds = {R.id.soft_key_2, R.id.soft_key_3, R.id.soft_key_4, R.id.soft_key_5,
+            R.id.soft_key_6, R.id.soft_key_7, R.id.soft_key_8, R.id.soft_key_9};
+    private final Rect hitRect = new Rect();
+    private final SwipeT9Gesture gesture = new SwipeT9Gesture();
+    private TraditionalT9 tt9;
+    private boolean tracking, captured;
+    private float startX, startY, lastX, lastY, pathLength, firstKeyWidth;
+    private int startDigit;
+
+    public SwipeT9TouchLayout(Context c) { super(c); }
+    public SwipeT9TouchLayout(Context c, AttributeSet a) { super(c, a); }
+    public SwipeT9TouchLayout(Context c, AttributeSet a, int s) { super(c, a, s); }
+
+    public void setTT9(TraditionalT9 handler) { this.tt9 = handler; }
+
+    public static boolean toggleEnabled(Context context) {
+        boolean enabled = !isEnabled(context);
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(ENABLED, enabled).apply();
+        return enabled;
+    }
+
+    private static boolean isEnabled(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean(ENABLED, false);
+    }
+
+    private int digitAt(float x, float y) {
+        for (int i = 0; i < digitIds.length; i++) {
+            View key = findViewById(digitIds[i]);
+            if (key != null && key.isShown() && key.getGlobalVisibleRect(hitRect)
+                    && hitRect.contains((int) x, (int) y)) return digitIdsToNumber(i);
+        }
+        return -1;
+    }
+
+    private int digitIdsToNumber(int i) {
+        return new int[] {2,3,4,5,6,7,8,9}[i];
+    }
+
+    private void sample(float x, float y) {
+        int digit = digitAt(x,y);
+        if (digit < 2) return;
+        View key = findViewById(digitIds[digit - 2]);
+        if (key != null) gesture.add(digit, x, y, key.getWidth(), key.getHeight());
+    }
+
+    private void clear() {
+        tracking = captured = false;
+        pathLength = 0;
+        gesture.reset();
+    }
+
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        int action = ev.getActionMasked();
+        // One finger only. No interception with TalkBack, special input fields or ABC/numeric mode.
+        if (action == MotionEvent.ACTION_DOWN) {
+            clear();
+            if (tt9 == null || !isEnabled(getContext()) || !tt9.isSwipeT9Allowed()) {
+                return super.dispatchTouchEvent(ev);
+            }
+            startDigit = digitAt(ev.getRawX(), ev.getRawY());
+            if (startDigit < 2) return super.dispatchTouchEvent(ev);
+            tracking = true;
+            startX = lastX = ev.getRawX();
+            startY = lastY = ev.getRawY();
+            View first = findViewById(digitIds[startDigit - 2]);
+            firstKeyWidth = first == null ? 70 : Math.max(20, first.getWidth());
+            sample(startX, startY);
+            super.dispatchTouchEvent(ev);
+            return true;
+        }
+        if (!tracking) return super.dispatchTouchEvent(ev);
+        if (action == MotionEvent.ACTION_POINTER_DOWN || action == MotionEvent.ACTION_CANCEL) {
+            if (!captured) super.dispatchTouchEvent(ev);
+            clear();
+            return true;
+        }
+        if (action == MotionEvent.ACTION_MOVE || action == MotionEvent.ACTION_UP) {
+            float x = ev.getRawX(), y = ev.getRawY();
+            pathLength += (float) Math.hypot(x - lastX, y - lastY);
+            lastX = x; lastY = y;
+            sample(x,y);
+            if (!captured && action == MotionEvent.ACTION_MOVE && pathLength >=
+                    Math.max(ViewConfiguration.get(getContext()).getScaledTouchSlop() * 2, firstKeyWidth * .35f)) {
+                // Cancel the key's normal tap/hold action, so one swipe is never typed twice.
+                MotionEvent cancel = MotionEvent.obtain(ev);
+                cancel.setAction(MotionEvent.ACTION_CANCEL);
+                super.dispatchTouchEvent(cancel);
+                cancel.recycle();
+                captured = true;
+            }
+            if (captured) {
+                if (action == MotionEvent.ACTION_UP) {
+                    String digits = gesture.getDigits();
+                    clear();
+                    if (digits.length() >= 2 && tt9 != null && tt9.isSwipeT9Allowed()) {
+                        tt9.onSwipeT9Sequence(digits);
+                    }
+                }
+                return true;
+            }
+            boolean result = super.dispatchTouchEvent(ev);
+            if (action == MotionEvent.ACTION_UP) clear();
+            return result;
+        }
+        return super.dispatchTouchEvent(ev);
+    }
+}
