diff --git a/scripts/setup-swipe-t9-signing.sh b/scripts/setup-swipe-t9-signing.sh
new file mode 100755
index 0000000..76b2f6c
--- /dev/null
+++ b/scripts/setup-swipe-t9-signing.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run in a GitHub Codespace while logged into Ronimedes/Swipe-T9.
+# Creates ONE permanent TEST key. Never commit it to Git!
+if ! command -v gh >/dev/null || ! command -v keytool >/dev/null; then
+  echo "FEHLER: GitHub CLI oder Java keytool fehlen im Codespace." >&2
+  exit 1
+fi
+
+REPO="Ronimedes/Swipe-T9"
+BACKUP="$PWD/.swipe-t9-private"
+KEYSTORE="$BACKUP/swipe-t9-debug.keystore"
+mkdir -p "$BACKUP"
+chmod 700 "$BACKUP"
+# Local exclude applies only to this Codespace; no keystore bytes go to Git.
+if ! grep -qxF '/.swipe-t9-private/' .git/info/exclude 2>/dev/null; then
+  printf '\n/.swipe-t9-private/\n' >> .git/info/exclude
+fi
+
+if [ ! -f "$KEYSTORE" ]; then
+  echo "Erzeuge neuen dauerhaften TEST-Signaturschluessel ..."
+  keytool -genkeypair -noprompt -keystore "$KEYSTORE" \
+    -storetype JKS -alias androiddebugkey -keyalg RSA -keysize 3072 -validity 10000 \
+    -storepass android -keypass android \
+    -dname 'CN=Swipe-T9 Test, OU=Development, O=Ronimedes, C=DE'
+  chmod 600 "$KEYSTORE"
+else
+  echo "Verwende bereits existierenden Signaturschluessel."
+fi
+
+echo "Uebertrage Testschluessel verschluesselt in GitHub Actions Secrets ..."
+base64 -w0 "$KEYSTORE" | gh secret set SWIPE_T9_DEBUG_KEYSTORE_B64 --repo "$REPO"
+echo
+printf 'ERFOLG. WICHTIG: SICHERE %s ausserhalb des Codespaces!\n' "$KEYSTORE"
+echo 'Niemals GitHub committen oder weitergeben. Ohne diese Datei sind zukuenftige Updates nicht mehr reproduzierbar.'
+echo 'Ein Wechsel vom bisherigen automatischen Debug-Schluessel kann EINMALIG eine Neuinstallation erfordern.'
