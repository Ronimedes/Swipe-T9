<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	style="@style/TTheme.Numpad.Column.Fn"
	android:id="@+id/numpad_column_fn_right">

	<!-- Intentionally empty spacer above the OK/send key to reduce accidental sends. -->
	<RelativeLayout style="@style/TTheme.Numpad.Key.Overlay.Wrapper" android:id="@+id/soft_key_wrapper_5" />

	<RelativeLayout style="@style/TTheme.Numpad.Key.Overlay.Wrapper" android:id="@+id/soft_key_wrapper_6">
		<io.github.sspanak.tt9.ui.main.keys.SoftKeyBackspace
			style="@style/TTheme.Numpad.Key.Large"
			android:id="@+id/soft_key_numpad_backspace"
			tools:ignore="Instantiatable" />
	</RelativeLayout>

	<RelativeLayout style="@style/TTheme.Numpad.Key.Overlay.Wrapper" android:id="@+id/soft_key_wrapper_7">
		<io.github.sspanak.tt9.ui.main.keys.SoftKeyJoin
			style="@style/TTheme.Numpad.Key.Large"
			android:id="@+id/soft_key_swipe_t9_join"
			tools:ignore="Instantiatable" />
	</RelativeLayout>

	<RelativeLayout style="@style/TTheme.Numpad.Key.Overlay.Wrapper" android:id="@+id/soft_key_wrapper_8">
		<io.github.sspanak.tt9.ui.main.keys.SoftKeyOk
			style="@style/TTheme.Numpad.Key.OK"
			android:id="@+id/soft_key_numpad_ok"
			tools:ignore="Instantiatable" />
	</RelativeLayout>
</LinearLayout>
